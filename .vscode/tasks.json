{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pdflatex: compile current file",
            "type": "shell",
            "command": "pdflatex",
            "args": ["-interaction=nonstopmode", "-halt-on-error", "${fileBasename}"],
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "clear": true },
            "problemMatcher": []
        }
    ]
}
