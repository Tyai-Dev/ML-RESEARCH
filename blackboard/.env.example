# Blackboard assistant API keys.
# Copy this file to `.env` (same folder) and fill in the keys you have —
# each provider works independently; leave the others empty.

# Claude  ->  platform.claude.com  ->  Settings -> API keys
ANTHROPIC_API_KEY=

# OpenAI  ->  platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini  ->  aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults: claude-opus-5 / gpt-5 / gemini-2.5-pro)
#BLACKBOARD_CLAUDE_MODEL=claude-opus-5
#BLACKBOARD_OPENAI_MODEL=gpt-5
#BLACKBOARD_GEMINI_MODEL=gemini-2.5-pro
